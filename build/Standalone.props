<Project>

  <!--
    Rueckfallfassung fuer einen Bau AUSSERHALB der Werkstatt des Autors.

    Sie wird nur importiert, wenn ueber dem Repo keine Directory.Build.props liegt
    (siehe ..\Directory.Build.props). Enthalten ist GENAU das, was dieses Repo braucht -
    nicht mehr. Wer hier etwas ergaenzt, das nur beim Autor gebraucht wird, baut die
    zweite Wahrheit wieder auf, die diese Datei beseitigen soll.
  -->

  <PropertyGroup>
    <!-- Die Attribute erzeugt das Target unten; ein zusaetzlicher SDK-Stempel gaebe CS0579. -->
    <GenerateAssemblyInfo Condition="'$(GenerateAssemblyInfo)' == ''">false</GenerateAssemblyInfo>
    <!-- Kein PDB-Pfad in der ausgelieferten DLL. Er traegt den Benutzernamen des Bauenden. -->
    <DebugType Condition="'$(DebugType)' == ''">None</DebugType>
    <DebugSymbols Condition="'$(DebugSymbols)' == ''">false</DebugSymbols>
    <!-- Das SDK haengt sonst '+<git-sha>' an die InformationalVersion. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    ============================================================================
    SPIELPFADE - hier ABSICHTLICH LEER.

    Bis zum 2026-08-19 standen ScheduleIPath, MelonLoaderPath und Il2CppAssemblyPath
    NUR in der Directory.Build.props der Werkstatt. Diese Rueckfallfassung kannte sie
    nicht - ein fremder Klon hatte damit keinen einzigen Spielpfad, und weil die
    Eigenschaften nicht einmal DEKLARIERT waren, konnte niemand erraten, welche Namen
    er in seiner Local.props setzen muesste. Gemessen in einem frischen Klon nach
    C:\Temp: 370x CS0246 (Il2CppScheduleOne, Il2CppSystem), und die Fehlermeldung
    zeigte auf den Quelltext statt auf die Konfiguration.

    ⚠ LEER LASSEN IST DIE REGEL, NICHT DIE LUECKE. Ein Vorgabewert wie
    'C:\Steam\steamapps\common\Schedule I' waere bequem und dreifach falsch: er traegt
    den Rechner des Autors ins Repo, er baut beim Fremden STILL gegen einen Pfad, den
    es dort nicht gibt, und er nimmt ihm die Fehlermeldung, die ihm sagt was zu tun
    ist. Leer heisst MSB3245 + CS0246 - laut, an der richtigen Stelle, und ohne dass je
    ein Benutzername in die Historie geraet.

    Gefuellt wird ueber Local.props (gitignoriert, Vorlage Local.props.example).
    ============================================================================
  -->
  <PropertyGroup>
    <ScheduleIPath Condition="'$(ScheduleIPath)' == ''"></ScheduleIPath>
    <MelonLoaderPath Condition="'$(MelonLoaderPath)' == ''"></MelonLoaderPath>
    <Il2CppAssemblyPath Condition="'$(Il2CppAssemblyPath)' == ''"></Il2CppAssemblyPath>
  </PropertyGroup>

  <!--
    ⚠ HIER WIRD NICHTS ABGELEITET, UND DAS IST NICHT VERGESSEN.
    Diese Datei wird ueber Directory.Build.props importiert und laeuft damit VOR dem Rumpf
    der .csproj - Local.props aber importiert die .csproj selbst (ScriptOne.csproj:7). Eine
    Ableitung wie 'MelonLoaderPath = $(ScheduleIPath)\MelonLoader\net6' saehe hier also
    immer ein LEERES ScheduleIPath und traege nie.

    Gemessen 2026-08-19 in einem frischen Klon, nachdem genau das hier zuerst stand:
    ScheduleIPath war aufgeloest, MelonLoaderPath blieb LEER, und der Bau meldete CS0246
    auf 'MelonLoader' - also einen Code-Fehler fuer ein Reihenfolgeproblem.
    Die Ableitung steht deshalb in ScriptOne.csproj, direkt hinter dem Local.props-Import.
  -->


  <!--
    Erzeugt MelonInfo.g.cs. Wortgleich in der Wirkung zur Werkstattfassung; die
    Abschaltschalter heissen genauso, damit eine csproj in beiden Umgebungen dasselbe tut.

    ⚠ Der Wert von MelonPlatformDomain kommt aus $(Configuration), NICHT aus einer
    Konstante. Eine handgeschriebene Zeile ist auf ein Backend verdrahtet und wird beim
    ersten Mono-Bau still falsch. Fuer andere Konfigurationen als Il2Cpp/Mono wird
    NICHTS erzeugt - lieber kein Attribut als ein geratenes.
  -->
  <Target Name="GenerateMelonInfo" BeforeTargets="CoreCompile" Condition="'$(MelonModName)' != ''">
    <PropertyGroup>
      <_MelonUrlParam Condition="'$(MelonModUrl)' != ''">, "$(MelonModUrl)"</_MelonUrlParam>
      <_MelonUrlParam Condition="'$(MelonModUrl)' == ''"></_MelonUrlParam>
      <_MelonCompanyParam Condition="'$(MelonGameCompany)' != '' and '$(MelonGameCompany)' != 'null'">"$(MelonGameCompany)"</_MelonCompanyParam>
      <_MelonCompanyParam Condition="'$(MelonGameCompany)' == 'null'">null</_MelonCompanyParam>

      <_MelonInfoLines>// Auto-generated by build\Standalone.props</_MelonInfoLines>
      <_MelonInfoLines Condition="'$(GenerateMelonInfoAttributes)' != 'false'">$(_MelonInfoLines);[assembly: MelonLoader.MelonInfo(typeof($(MelonModType)), &quot;$(MelonModName)&quot;, &quot;$(Version)&quot;, &quot;$(MelonModAuthor)&quot;$(_MelonUrlParam))];[assembly: MelonLoader.MelonGame($(_MelonCompanyParam), &quot;$(MelonGameName)&quot;)]</_MelonInfoLines>
      <_MelonInfoLines Condition="'$(EmbedVersionAttributes)' != 'false'">$(_MelonInfoLines);[assembly: System.Reflection.AssemblyVersion(&quot;$(Version)&quot;)];[assembly: System.Reflection.AssemblyFileVersion(&quot;$(Version)&quot;)];[assembly: System.Reflection.AssemblyInformationalVersion(&quot;$(Version)&quot;)];[assembly: System.Reflection.AssemblyCompany(&quot;$(Authors)&quot;)];[assembly: System.Reflection.AssemblyCopyright(&quot;$(Copyright)&quot;)]</_MelonInfoLines>

      <_PlatformDomain Condition="'$(Configuration)' == 'Il2Cpp'">IL2CPP</_PlatformDomain>
      <_PlatformDomain Condition="'$(Configuration)' == 'Mono'">MONO</_PlatformDomain>
      <_MelonInfoLines Condition="'$(GeneratePlatformDomainAttribute)' != 'false' and '$(_PlatformDomain)' != ''">$(_MelonInfoLines);[assembly: MelonLoader.MelonPlatformDomain(MelonLoader.MelonPlatformDomainAttribute.CompatibleDomains.$(_PlatformDomain))]</_MelonInfoLines>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)MelonInfo.g.cs" Lines="$(_MelonInfoLines)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)MelonInfo.g.cs" />
    </ItemGroup>
  </Target>

  <!--
    Die Auslieferungskopie <Name>.IL2CPP.dll / <Name>.MONO.dll. Der einfache
    Assembly-Name bleibt unveraendert, es ist nur ein Dateiname - sonst braeche
    MelonAdditionalDependencies("<Name>").

    Sie ist die einzige Markierung, an der man einem Paket ansieht, fuer welches Backend
    die DLL ist. Fehlt sie, liegen zwei gleichnamige Dateien nebeneinander.
  -->
  <Target Name="CopyBackendSuffixedDll" AfterTargets="Build"
          Condition="'$(MelonModName)' != '' and ('$(Configuration)' == 'Il2Cpp' or '$(Configuration)' == 'Mono')
                     and !$(TargetName.ToUpperInvariant().EndsWith('IL2CPP')) and !$(TargetName.ToUpperInvariant().EndsWith('MONO'))">
    <PropertyGroup>
      <_BackendSuffix Condition="'$(Configuration)' == 'Il2Cpp'">IL2CPP</_BackendSuffix>
      <_BackendSuffix Condition="'$(Configuration)' == 'Mono'">MONO</_BackendSuffix>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)$(TargetName).$(_BackendSuffix).dll" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="[$(MelonModName)] v$(Version) -> $(TargetName).$(_BackendSuffix).dll" />
  </Target>

</Project>
